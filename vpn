#!/usr/bin/zsh

typeset -r PIDFILE="/run/user/$UID/openconnect.pid"
typeset -r DEV="/sys/devices/virtual/net/tun0"

function create_tun0() {
  sudo ip tuntap add tun0 mode tun user $USER
}

function destroy_tun0() {
  sudo ip tuntap del tun0 mode tun
}

function start_vpn() {
  local keyfile="$(mktemp --tmpdir "$USER-vpn-XXXXXXXX.rsa")"
  local configfile="$HOME/.config/openconnect/cisco-cert.conf"
  local url='https://vpn.vt.edu/NIS-Cert'
  chmod 600 $keyfile
  pass show 'waldrep@vt.edu/pdc' > "$keyfile"
  openconnect \
    --background \
    --pid-file="$PIDFILE" \
    --config="$configfile" \
    --sslkey="$keyfile" \
    "$url"
  rm "$keyfile"
}

function stop_vpn() {
  kill -SIGTERM -- $(cat "$PIDFILE")
}

function restart_vpn() {
  kill -SIGUSR2 -- $(cat "$PIDFILE")
}

function status() {
  if ! int_up; then
    echo 'Interface tun0 not created'
  elif ! proto_up; then
    echo 'Protocol down'
  fi

  if ! [[ -f "$PIDFILE" ]]; then
    echo 'openconnect PID file not found'
    exit 1
  fi

  kill -SIGUSR1 -- $(cat "$PIDFILE")
}

function int_up() {
  [[ -d "$DEV" ]]
}

function proto_up() {
  [[ "$(cat "$DEV/operstate")" == 'up' ]]
}

case "$1" in
  ('start')
    int_up || create_tun0
    proto_up || start_vpn "$2"
    ;;
  ('restart')
    restart_vpn
    ;;
  ('stop')
    int_up || exit 0
    proto_up && stop_vpn
    while proto_up; do
      sleep 1
    done
    int_up && destroy_tun0
    ;;
  ('status')
    status
    ;;
esac
