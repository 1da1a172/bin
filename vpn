#!/usr/bin/zsh

typeset -r PIDFILE="/run/user/$UID/openconnect.pid"
typeset -r DEV="/sys/devices/virtual/net/oc0"

function create_oc0() {
  sudo ip tuntap add oc0 mode tun user $USER
}

function destroy_oc0() {
  sudo ip tuntap del oc0 mode tun
}

function start_vpn() {
  local keyfile="$(mktemp --tmpdir "$USER-vpn-XXXXXXXX.rsa")"
  chmod 600 $keyfile
  pass show 'waldrep@vt.edu/pdc' > "$keyfile"
  openconnect \
    --background \
    --config=$HOME/.config/openconnect/config \
    --sslkey="$keyfile" \
    --pid-file="$PIDFILE" \
    'https://vpn.nis.vt.edu/nis/certauth'
  rm "$keyfile"
}

function stop_vpn() {
  kill -SIGTERM -- $(cat "$PIDFILE")
}

function restart_vpn() {
  kill -SIGUSR2 -- $(cat "$PIDFILE")
}

function status() {
  if ! int_up; then
    echo 'Interface oc0 not created'
  elif ! proto_up; then
    echo 'Protocol down'
  fi

  if ! [[ -f "$PIDFILE" ]]; then
    echo 'openconnect PID file not found'
    exit 1
  fi

  kill -SIGUSR1 -- $(cat "$PIDFILE")
}

function int_up() {
  [[ -d "$DEV" ]]
}

function proto_up() {
  [[ "$(cat "$DEV/operstate")" == 'up' ]]
}

case "$1" in
  ('start')
    int_up || create_oc0
    proto_up || start_vpn
    ;;
  ('restart')
    restart_vpn
    ;;
  ('stop')
    int_up || exit 0
    proto_up && stop_vpn
    while proto_up; do
      sleep 1
    done
    int_up && destroy_oc0
    ;;
  ('status')
    status
    ;;
esac
